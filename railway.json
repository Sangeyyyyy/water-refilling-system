{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "healthcheckPath": "/login",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "postDeployCommand": "php artisan migrate --force && php artisan optimize"
    }
}